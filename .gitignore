# real student submissions - never commit these to a shared repo
submissions/*
!submissions/.gitkeep

# scratch copies of submissions for local testing - never commit these either
submissions2/*
!submissions2/.gitkeep

# this week's official test cases / rubric - course material, never commit these either
tests/*
!tests/.gitkeep

build_tmp/
# JVM crash dumps from a javac subprocess that ran out of memory/died -
# land in the repo root (JDK's own default location), never commit these
hs_err_pid*.log
replay_pid*.log
results/*.csv
# extracted student code from failed-to-compile submissions (see grade_student
# in grade.py) - same privacy category as submissions/, never commit it
results/failed_builds/
# junit-platform-console-standalone is committed on purpose (see lib/README.md)
# so a fresh clone works without a manual download - ignore any OTHER jar
# someone drops in here instead (e.g. a stray version bump left alongside it)
lib/*.jar
!lib/junit-platform-console-standalone-1.14.0.jar
__pycache__/
*.pyc

.claude/
docs/superpowers/
