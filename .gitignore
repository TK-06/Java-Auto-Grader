# real student submissions - never commit these to a shared repo
submissions/*
!submissions/.gitkeep

# this week's official test cases / rubric - course material, never commit these either
tests/*
!tests/.gitkeep

build_tmp/
results/*.csv
# extracted student code from failed-to-compile submissions (see grade_student
# in grade.py) - same privacy category as submissions/, never commit it
results/failed_builds/
lib/*.jar
__pycache__/
*.pyc

.claude/
